# ==============================================================================
# Portfolio Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your secret credentials locally.
# NEVER commit the real .env file or credentials to source control or GitHub!

# Backend Server Port
PORT=5000

# Owner Account Username
OWNER_USERNAME=kritika

# Cryptographically strong secret key used by Express to sign and verify owner JWT session tokens.
# Replace with a unique, high-entropy secret string in your private local .env.
JWT_SECRET=your_jwt_secret_key_here

# Bcrypt hash of the owner password.
# To generate a fresh bcrypt hash for your password, run:
# node -e "const bcrypt = require('bcryptjs'); console.log(bcrypt.hashSync('YourStrongPassword', 10));"
OWNER_PASSWORD_HASH=your_bcrypt_hash_here
